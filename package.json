{
  "name": "brand",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "bugs": {
    "url": "https://github.com/udecode/brand/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/brand.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "module": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "brl": "sh .changeset/brl.sh",
    "build": "tsup",
    "build:watch": "tsup:watch",
    "lint": "npx ultracite@latest check",
    "lint:fix": "npx ultracite@latest fix",
    "release": "pnpm build && pnpm changeset publish",
    "typecheck": "pnpm tsc --noEmit",
    "typecheck:watch": "pnpm tsc --noEmit --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "@changesets/cli": "2.29.7",
    "@changesets/get-github-info": "0.6.0",
    "@types/node": "^24.7.2",
    "barrelsby": "^2.8.1",
    "lefthook": "^2.0.0",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "ultracite": "5.6.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
