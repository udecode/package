    "release": "pnpm build && pnpm changeset publish",
    "typecheck": "pnpm tsc --noEmit",
    "typecheck:watch": "pnpm tsc --noEmit --watch"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@changesets/get-github-info": "0.6.0",
    "@eslint/compat": "1.4.0",
