{
  "name": "TEMPLATE",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "bugs": {
    "url": "https://github.com/udecode/TEMPLATE/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/udecode/TEMPLATE.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "brl": "sh tooling/brl.sh",
    "build": "tsdown --config tooling/tsdown.config.ts",
    "build:watch": "tsdown --config tooling/tsdown.config.ts --watch",
    "postinstall": "bunx skiller apply",
    "lint": "biome check && eslint",
    "lint:fix": "biome check --write",
    "release": "bun run build && bun changeset publish",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "2.29.7",
    "@rollup/plugin-babel": "^6.1.0",
    "@types/node": "^24.7.2",
    "@typescript-eslint/parser": "^8.47.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "barrelsby": "^2.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "lefthook": "^2.0.0",
    "tsdown": "^0.16.6",
    "typescript": "5.9.3",
    "ultracite": "6.3.6"
  },
  "packageManager": "bun@1.3.3",
  "publishConfig": {
    "access": "public"
  }
}
